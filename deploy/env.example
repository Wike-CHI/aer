# AER deployment environment — TEMPLATE ONLY.
#
# Copy to `deploy/.env` on the production host and edit there:
#
#     cp deploy/env.example /srv/aer/deploy/.env
#
# `deploy/.env` is git-ignored and must never be committed. This template
# contains **no secrets by design**: AER's runtime configuration is paths and a
# log level, nothing else. Credentials (registry tokens, SSH keys) live in the
# host's docker credential store and in GitHub Environment secrets -- never here.

# ---------------------------------------------------------------------------
# Container-side paths.
#
# These are the paths *inside* the container. They must match the volume targets
# in compose.yaml and are what aer.config reads via AER_* variables.
# ---------------------------------------------------------------------------
AER_ENV=production
AER_DATA_DIR=/data
AER_ARTIFACT_DIR=/artifacts
AER_KNOWLEDGE_DIR=/knowledge
AER_BACKUP_DIR=/backups
AER_LOG_LEVEL=INFO

# Optional, and normally NOT set: the image deliberately bakes only AER_DATA_DIR,
# because AER_DB_PATH wins over it in aer.config and a baked file path would make
# any `-e AER_DATA_DIR=...` override silently ineffective. Set this only to use a
# non-standard database filename. It is the same variable `alembic.ini` resolves
# against, so a manual `alembic upgrade head` and the runtime always agree.
# AER_DB_PATH=/data/aer.db

# ---------------------------------------------------------------------------
# Image reference.
#
# Normally left empty here: `deploy/current.env` is the authoritative record of
# which immutable SHA tag is live, and `scripts/deploy.sh` exports it before
# invoking compose (the shell environment wins over this file during
# interpolation). Set it only to pin an override by hand.
# ---------------------------------------------------------------------------
AER_IMAGE=

# ---------------------------------------------------------------------------
# Host-side paths (the real persistent volumes).
#
# Note the naming: `AER_HOST_*` are paths on the **server**, `AER_*` above are
# paths in the **container**. They are separate variables on purpose -- using one
# name for both is how a container silently writes to an unmounted directory and
# loses the database on the next `docker compose down`.
# ---------------------------------------------------------------------------
AER_HOST_DATA_DIR=/srv/aer/data
AER_HOST_ARTIFACT_DIR=/srv/aer/artifacts
AER_HOST_KNOWLEDGE_DIR=/srv/aer/knowledge
AER_HOST_BACKUP_DIR=/srv/aer/backups

# ---------------------------------------------------------------------------
# Operational tuning.
# ---------------------------------------------------------------------------

# Backup retention: how many timestamped backups `scripts/backup_sqlite.py`
# keeps before deleting the oldest. 20 daily deployments is roughly a month.
AER_BACKUP_RETENTION=20

# Where `scripts/deploy.sh` writes its step log on the host. stdout is always
# used too, so `docker logs`/CI logs are self-sufficient.
AER_LOG_DIR=/srv/aer/logs
